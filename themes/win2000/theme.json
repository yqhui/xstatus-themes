{
  "name": "Win2000 · XStatus",
  "short": "win2000",
  "version": "1.0.2",
  "type": "spa",
  "author": "guboysky / tom2almighty / yqhui",
  "description": "原生 XStatus 经典桌面主题，节点卡片、网络质量、服务状态。",
  "config": [
    {
      "key": "title",
      "type": "string",
      "label": "站点标题（空白跟随站点设置）",
      "default": ""
    },
    {
      "key": "skin",
      "type": "select",
      "label": "桌面风格",
      "default": "win2000",
      "options": [
        {
          "value": "win2000",
          "label": "Windows 2000"
        },
        {
          "value": "win31",
          "label": "Windows 3.1"
        },
        {
          "value": "xp",
          "label": "Windows XP"
        },
        {
          "value": "aqua",
          "label": "Aqua"
        }
      ]
    }
  ]
}
